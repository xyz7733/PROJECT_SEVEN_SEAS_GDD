#!/bin/sh
# Install with: git config --local core.hooksPath .githooks
set -eu
cd "$(git rev-parse --show-toplevel)"
for python_command in python3 python; do
    if command -v "$python_command" >/dev/null 2>&1 && "$python_command" -c 'import sys; sys.exit(sys.version_info < (3, 10))' >/dev/null 2>&1; then
        if "$python_command" tools/repo/check.py --staged; then
            exit 0
        fi
        echo "Commit stopped: fix the repository check errors, stage the fixes, and retry." >&2
        exit 1
    fi
done
echo "Commit stopped: Python 3.10+ is required for tools/repo/check.py --staged; install it or activate your Python environment." >&2
exit 1
