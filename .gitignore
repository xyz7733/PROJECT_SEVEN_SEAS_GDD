# Godot import/build cache (regenerated by the editor)
/game/.godot/

# Exported game builds and archived build checkpoints (large binaries)
/build/

# Bundled engine binaries, export templates and downloaded font packages
/tools/godot/
/tools/fonts/

# Python virtualenv and caches for the art generators
/tools/artgen/.venv/
**/__pycache__/
*.py[cod]

# Local development environments and tool caches
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
node_modules/

# Local secrets and Godot export credentials
.env
.env.*
!.env.example
export_credentials.cfg
*.p7s

# Personal editor state
.idea/
*.code-workspace
*.swp
*.swo

# OS junk
Thumbs.db
Desktop.ini
.DS_Store
