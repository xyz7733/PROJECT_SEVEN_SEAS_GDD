; Engine configuration file.
; Project Seven Seas — native Godot 4 project (GDScript, GL Compatibility).

config_version=5

[application]

config/name="Project Seven Seas"
config/description="Isometric pixel-art seafaring management and expedition game."
config/version="2.0.0"
config/build_revision="craft-01-fix1"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.039, 0.07, 0.11, 1)
boot_splash/show_image=false
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"

[autoload]

C="*res://scripts/core/content.gd"
Settings="*res://scripts/core/settings.gd"
Display="*res://scripts/core/display.gd"
I18n="*res://scripts/core/i18n.gd"
Game="*res://scripts/core/game.gd"
Art="*res://scripts/view/art.gd"
Audio="*res://scripts/core/audio.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="fractional"

[internationalization]

locale/translations=PackedStringArray("res://i18n/strings.en.translation", "res://i18n/strings.zh_CN.translation")
locale/fallback="en"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.039, 0.07, 0.11, 1)
