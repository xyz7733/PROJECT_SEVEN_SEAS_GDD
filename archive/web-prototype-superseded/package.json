{
  "name": "project-seven-seas",
  "version": "1.0.0",
  "private": true,
  "description": "Offline single-player pirate crew management and auto-battle game in vanilla HTML, CSS, and JavaScript.",
  "license": "UNLICENSED",
  "engines": { "node": ">=22" },
  "scripts": {
    "check": "node tests/check.js",
    "test": "node --test \"tests/*.test.js\"",
    "smoke": "node tests/smoke.mjs",
    "bot": "node tests/bot.js",
    "serve": "python3 -m http.server 8000",
    "verify": "node tests/check.js && node --test \"tests/*.test.js\" && node tests/smoke.mjs"
  }
}
